HTTP_ADDR=:8080
POSTGRES_DSN=postgres://booking:booking@localhost:55432/booking?sslmode=disable
TEMPORAL_ADDRESS=localhost:7233
TASK_QUEUE=supplier

SUPPLIER_BASE_URL=http://localhost:8080/mock-supplier
SUPPLIER_DEADLINE=90s
# Must exceed SUPPLIER_DEADLINE or the -timeout scenario never times out.
MOCK_TIMEOUT_HOLD=25s
MOCK_CALLBACK_DELAY=12s
# Mounts an unauthenticated supplier on the API port. Off unless set.
SUPPLIER_MOCK_ENABLED=true

# Required. The service refuses to start without it.
CALLBACK_TOKEN=
CALLBACK_BASE_URL=http://localhost:8080

CREATE_ATTEMPTS=2
PARK_TIMEOUT=24h

SWEEP_INTERVAL=15s
SWEEP_RECEIVED_THRESHOLD=30s
SWEEP_INFLIGHT_THRESHOLD=15m

SHUTDOWN_TIMEOUT=105s

# Publishes the whole API surface. Off unless set.
SWAGGER_ENABLED=true
